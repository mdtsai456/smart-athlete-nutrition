digraph ERD {
graph [rankdir=LR, bgcolor="white",pad=0.45,nodesep=0.4,ranksep=1.0,splines=spline,overlap=false,fontname="DejaVu Sans",label="Athlete nutrition | MVP v9 | 16 tables\nRelationship overview: primary and foreign keys\nPK primary key | FK foreign key | UQ unique | G generated | NN not null\nCrow-foot = many | circle = optional | paired bars = exactly one\nOrange dashed edges = actor / audit account references\nComposite indexes and CHECK rules: see DBML / SQL",labelloc=t,fontsize=22];
node [shape=plain,fontname="DejaVu Sans"];
edge [fontname="DejaVu Sans",fontsize=9,arrowsize=0.7,color="#94a3b8",penwidth=1.1];
